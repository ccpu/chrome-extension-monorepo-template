{
  "name": "@internal/eslint-config",
  "type": "module",
  "version": "0.3.0",
  "private": true,
  "exports": {
    "./base": "./base.mjs",
    "./nextjs": "./nextjs.mjs",
    "./react": "./react.mjs"
  },
  "scripts": {
    "clean": "git clean -xdf .cache .turbo dist",
    "clean:all": "git clean -xdf .cache .turbo dist node_modules",
    "format": "prettier --check . --ignore-path ../../.gitignore --ignore-path ../../.prettierignore",
    "lint": "eslint",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@pixpilot/eslint-config": "catalog:lint",
    "@pixpilot/eslint-config-next": "catalog:lint",
    "@pixpilot/eslint-config-react": "catalog:lint",
    "eslint-plugin-jest": "catalog:lint",
    "eslint-plugin-turbo": "catalog:lint"
  },
  "devDependencies": {
    "@internal/prettier-config": "workspace:*",
    "@internal/tsconfig": "workspace:*",
    "eslint": "catalog:lint",
    "prettier": "catalog:format",
    "typescript": "catalog:typescript"
  },
  "prettier": "@internal/prettier-config"
}
