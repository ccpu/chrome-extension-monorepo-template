{
  "name": "@internal/vitest-config",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./lib": {
      "types": "./lib.d.ts",
      "default": "./lib.js"
    },
    "./react": {
      "types": "./react.d.ts",
      "default": "./react.js"
    }
  },
  "main": "./index.js",
  "types": "./index.d.ts",
  "scripts": {
    "build": "tsc",
    "clean": "git clean -xdf .cache .turbo dist",
    "clean:all": "git clean -xdf .cache .turbo dist node_modules",
    "typecheck": "tsc --noEmit",
    "lint": "eslint",
    "format": "prettier --check . --ignore-path ../../.gitignore --ignore-path ../../.prettierignore"
  },
  "devDependencies": {
    "@internal/prettier-config": "workspace:*",
    "@internal/tsconfig": "workspace:*",
    "@pixpilot/dev-config": "catalog:pixpilot",
    "@testing-library/dom": "catalog:testing",
    "@testing-library/react": "catalog:testing",
    "@vitest/coverage-v8": "catalog:testing",
    "eslint": "catalog:tooling",
    "jsdom": "catalog:testing",
    "vitest": "catalog:testing"
  },
  "prettier": "@internal/prettier-config"
}
