{
  "name": "chrome-extension-monorepo-template",
  "private": true,
  "packageManager": "pnpm@10.18.0",
  "description": "A production-ready Chrome extension monorepo template with TypeScript, Vite, Turborepo, and modern tooling for fast development.",
  "keywords": [
    "chrome-extension",
    "monorepo",
    "typescript",
    "vite",
    "turborepo",
    "template",
    "manifest-v3"
  ],
  "engines": {
    "node": ">=22.14.0",
    "pnpm": ">=9.6.0"
  },
  "scripts": {
    "setup": "npx @pixpilot/scaffoldfy --config ./setup/scaffoldfy.json",
    "dev": "turbo run dev",
    "build": "turbo run build",
    "tsc:watch": "pnpm exec tsc --noEmit --watch --project tsconfig.watch.json",
    "format": "turbo run format --continue -- --cache --cache-location .cache/.prettiercache",
    "format:fix": "pnpm format --write",
    "lint": "turbo run lint --continue -- --cache --cache-location .cache/.eslintcache && pnpm lint:root",
    "lint:fix": "pnpm lint --fix && pnpm lint:root:fix",
    "lint:root": "eslint *.config.{js,cjs,mjs,ts} *.json README.md --cache --cache-location .cache/.eslintcache",
    "lint:root:fix": "pnpm lint:root --fix",
    "lint:ws": "pnpm dlx sherif@latest",
    "fix:all": "pnpm format:fix && pnpm lint:fix",
    "postinstall": "pnpm lint:ws && node setup/guard.mjs warn",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage --config tooling/vitest/index.js",
    "prepare": "husky",
    "clean:workspaces": "turbo run clean:all && git clean -xdf .cache .turbo",
    "clean:workspaces:install": "pnpm clean:workspaces && pnpm install",
    "deps:update": "npx taze -r -w && pnpm install",
    "deps:update:major": "npx taze major -r -w && pnpm install",
    "gen:package": "npx @pixpilot/scaffoldfy --config ./generators/package/scaffoldfy.json"
  },
  "devDependencies": {
    "@changesets/cli": "catalog:dev",
    "@commitlint/cli": "catalog:dev",
    "@commitlint/config-conventional": "catalog:dev",
    "@internal/prettier-config": "workspace:*",
    "@pixpilot/dev-config": "catalog:dev",
    "@pixpilot/workspace-package-generator": "catalog:dev",
    "@testing-library/jest-dom": "catalog:dev",
    "@turbo/gen": "catalog:dev",
    "@types/chrome": "catalog:dev",
    "@vitest/coverage-v8": "catalog:dev",
    "@vitest/ui": "catalog:dev",
    "eslint": "catalog:dev",
    "husky": "catalog:dev",
    "lint-staged": "catalog:dev",
    "prettier": "catalog:dev",
    "prettier-plugin-tailwindcss": "catalog:dev",
    "tsx": "catalog:dev",
    "turbo": "catalog:dev",
    "typescript": "catalog:dev",
    "vitest": "catalog:dev"
  },
  "prettier": "@internal/prettier-config"
}
